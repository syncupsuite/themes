{
  "name": "@syncupsuite/transformers",
  "version": "0.1.0",
  "description": "Token transformers — Tailwind v4 CSS, plain CSS custom properties",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/syncupsuite/themes.git",
    "directory": "packages/transformers"
  },
  "homepage": "https://github.com/syncupsuite/themes#readme",
  "keywords": ["design-tokens", "tailwind", "css", "transformer", "syncupsuite"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@syncupsuite/tokens": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
