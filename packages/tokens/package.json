{
  "name": "@syncupsuite/tokens",
  "version": "0.2.0",
  "description": "DTCG design token types, utilities, and validation — zero runtime dependencies",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/syncupsuite/themes.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/syncupsuite/themes#readme",
  "keywords": [
    "design-tokens",
    "dtcg",
    "typescript",
    "syncupsuite"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
