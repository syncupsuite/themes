{
  "$name": "renaissance",
  "$description": "Renaissance (Rinascimento) — the rich humanist palette of Italian masters, from lapis lazuli ultramarine to Tuscan earth and gold leaf",
  "$extensions": {
    "syncupsuite.foundation": {
      "story": "The Italian Renaissance (14th–17th century) transformed art through oil painting, linear perspective, and a palette derived from mineral pigments traded across the Mediterranean. Ultramarine from Afghan lapis lazuli cost more than gold. Tuscan earth pigments — sienna, umber, ochre — grounded compositions in warmth. Gold leaf connected human achievement to divine light. The palette of Raphael, Titian, and Botticelli remains the Western canon's richest.",
      "philosophy": "Rinascimento — the rebirth of classical learning, humanist confidence in beauty and proportion",
      "era": "Italian Renaissance (14th–17th century)",
      "harmonyMode": "triadic",
      "radiusTendency": "moderate",
      "typographyCategory": "modern-serif"
    }
  },
