            "syncupsuite.provenance": {
              "name": "Oltremare (Ultramarine)",
              "tradition": "From lapis lazuli mined in Badakhshan, Afghanistan — ground, purified, and mixed with oil. More expensive than gold per ounce, it was reserved for the Virgin Mary's robe.",
