{
  "$name": "nihon-minimal",
  "$description": "Nihon Minimal (日本のミニマル) — the refined austerity of modern Japanese design, from Muji to Naoto Fukasawa, where less is enough",
  "$extensions": {
    "syncupsuite.foundation": {
      "story": "Modern Japanese minimalism synthesizes Zen Buddhist emptiness (空, kū) with industrial design precision. Kenya Hara's 'designing white,' Naoto Fukasawa's 'without thought' (無意識のデザイン), and the Muji philosophy of 'no-brand quality goods' all express the same insight: beauty emerges when you remove everything unnecessary. The palette is almost achromatic — warmth from natural materials, not color.",
      "philosophy": "無印 (Mujirushi) — no-brand, the beauty of nothing; emptiness as fullness",
      "era": "1980s–present",
      "harmonyMode": "monochromatic",
      "radiusTendency": "subtle",
      "typographyCategory": "geometric-sans"
    }
  },
