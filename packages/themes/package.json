{
  "name": "@syncupsuite/themes",
  "version": "0.1.0",
  "description": "Pre-built, culturally-grounded design themes — ready to use",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./*/*.css": "./src/*/*.css",
    "./*/*.json": "./src/*/*.json"
  },
  "files": [
    "dist",
    "src/*/tokens.css",
    "src/*/tailwind.css",
    "src/*/tokens.json",
    "src/*/meta.json"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@syncupsuite/foundations": "workspace:*",
    "@syncupsuite/tokens": "workspace:*",
    "@syncupsuite/transformers": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
