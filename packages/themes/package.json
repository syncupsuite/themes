{
  "name": "@syncupsuite/themes",
  "version": "0.1.1",
  "description": "Pre-built, culturally-grounded design themes — ready to use",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/syncupsuite/themes.git",
    "directory": "packages/themes"
  },
  "homepage": "https://github.com/syncupsuite/themes#readme",
  "keywords": [
    "design-tokens",
    "design-system",
    "themes",
    "tailwind",
    "css",
    "cultural",
    "swiss",
    "japanese",
    "syncupsuite"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*/*.css": "./src/*/*.css",
    "./*/*.json": "./src/*/*.json"
  },
  "files": [
    "dist",
    "src/*/tokens.css",
    "src/*/tailwind.css",
    "src/*/tokens.json",
    "src/*/meta.json"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@syncupsuite/tokens": "workspace:*"
  },
  "devDependencies": {
    "@syncupsuite/foundations": "workspace:*",
    "@syncupsuite/transformers": "workspace:*",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
