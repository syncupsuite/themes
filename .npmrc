# Scoped package access — all @syncupsuite packages are public
@syncupsuite:registry=https://registry.npmjs.org/
access=public

# Auth token injected at runtime via Doppler (syncupsuite-marketplace project)
# Never commit a real token here — reads from NPM_TOKEN environment variable
# //registry.npmjs.org/:_authToken=${NPM_TOKEN}  ← uncomment once Doppler token has bypass-2FA set
